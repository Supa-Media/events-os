---
/**
 * The blog index — published posts only. Drafts live at /blog/drafts/<slug>
 * behind pw-router's password gate and are never listed here.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import { formatPostDate, getPublishedPosts, isoDate, postPath } from "../../lib/blog";
import { asset } from "../../lib/asset";

const posts = await getPublishedPosts();
const feedHref = asset("/rss.xml");
---

<BaseLayout
  title="Blog"
  description="Writing from the Public Worship team on worship, songwriting, and taking Jesus into the streets of New York City."
  canonical={new URL("/blog", Astro.site).toString()}
>
  <Container size="narrow" class="py-16 sm:py-24">
    <div class="flex flex-col items-start gap-3" data-animate="fade-up">
      <Eyebrow icon="sparkle">Public Worship</Eyebrow>
      <h1
        class="font-display font-normal leading-[1.08] text-3xl sm:text-[42px] md:text-[52px]"
      >
        The <span class="text-red-500">Blog</span>
      </h1>
      <p class="max-w-prose text-lg leading-relaxed text-ink/75">
        Writing from our team on worship, songwriting, and what we're learning
        taking Jesus into the streets, parks, and trains of New York City.
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-12 text-lg text-ink/70">
          Nothing published yet — the first pieces are being written now. Check
          back soon.
        </p>
      ) : (
        <ul class="mt-12 space-y-10">
          {posts.map((post, i) => (
            <li
              class="border-t border-red-100 pt-8 first:border-t-0 first:pt-0"
              data-animate="fade-up"
              style={`--delay: ${i * 60}ms`}
            >
              <article>
                {post.data.audience && (
                  <p class="font-display text-sm text-red-500">
                    Written for {post.data.audience}
                  </p>
                )}
                <h2 class="mt-2 font-display text-2xl font-normal leading-tight">
                  <a
                    href={postPath(post)}
                    class="hover:text-red-500"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-3 leading-relaxed text-ink/75">
                  {post.data.description}
                </p>
                <p class="mt-3 text-sm text-ink/60">
                  <time datetime={isoDate(post.data.pubDate)}>
                    {formatPostDate(post.data.pubDate)}
                  </time>
                </p>
              </article>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-16 text-sm text-ink/60">
      Prefer a reader? <a
        href={feedHref}
        class="text-red-500 underline decoration-red-200 underline-offset-2 hover:decoration-red-500"
        >Subscribe by RSS</a
      >.
    </p>
  </Container>
</BaseLayout>

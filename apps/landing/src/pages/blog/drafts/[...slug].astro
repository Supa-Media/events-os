---
/**
 * An unpublished post, at /blog/drafts/<slug>.
 *
 * Everything under this prefix is held behind a shared password by pw-router
 * (infra/router/src/draftGate.ts) — that gate, not this page, is what keeps a
 * draft private. This page's job is to make the draft LOOK exactly like the
 * published post will (same layout, same reaction bar) so a reviewer is
 * reading the real thing, while staying out of search: `noindex` via
 * PostLayout, out of the sitemap via astro.config.mjs's filter, and out of
 * the index and RSS feed via src/lib/blog.ts.
 *
 * The canonical points at the post's FUTURE published URL, so if a draft link
 * ever escapes, search engines are pointed at where the post will actually
 * live rather than indexing the gated copy.
 */
import { render } from "astro:content";
import PostLayout from "../../../layouts/PostLayout.astro";
import { getDraftPosts, readingMinutes } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getDraftPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonical = new URL(`/blog/${post.id}`, Astro.site).toString();
---

<PostLayout
  post={post}
  headings={headings}
  readingMinutes={readingMinutes(post.body)}
  canonical={canonical}
>
  <Content />
</PostLayout>

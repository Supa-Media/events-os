---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import HeroVideo from "../components/sections/HeroVideo.astro";
import About from "../components/sections/About.astro";
import ImpactStats from "../components/sections/ImpactStats.astro";
import ImportantLinks from "../components/sections/ImportantLinks.astro";
import FaqList from "../components/sections/FaqList.astro";
import DonateCta from "../components/sections/DonateCta.astro";
import MidVideo from "../components/sections/MidVideo.astro";
---

<BaseLayout
  title="Bringing God's presence into public spaces"
  description="Public Worship is a worship initiative of Global Echo Charitable Co., a 501(c)(3) nonprofit, bringing bold, public Jesus worship into the streets, parks, and trains of New York City."
>
  <Hero />
  <HeroVideo />
  <ImportantLinks />
  <About />
  <DonateCta cards="icons" />
  <ImpactStats />
  <MidVideo />
  <FaqList />
  <DonateCta
    eyebrow="Support"
    heading={`Support Us <span class="text-red-500">Through Your Generosity</span>`}
    cards="illustrations"
  />
</BaseLayout>

{/* The homepage's OS-managed content — hero copy, the impact numbers, and the
    Important Links grid — patched over the built markup once
    `GET /api/site/home` answers. One fetch for all three; degrades silently to
    the page as built. See `scripts/site-content.ts`. */}
<script>
  import "../scripts/site-content";
</script>

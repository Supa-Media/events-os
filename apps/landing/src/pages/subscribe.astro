---
/**
 * /subscribe — the mailing-list signup.
 *
 * This is what replaced the Google Form the marketing team was handing out.
 * The form is not the point; where it lands is. A Google Form deposited names
 * into a spreadsheet nothing else in the org could see, so every signup was a
 * manual re-entry away from being reachable and nobody could answer "did this
 * person ever actually say yes?" This posts to `/api/subscribe`, which writes
 * the person, the consent, and the timestamp onto the same `people` row the
 * rest of Chapter OS already uses.
 *
 * `?c=<chapter-slug>` joins a specific chapter's list — the per-chapter link
 * the Marketing desk copies. Plain `/subscribe` joins the home chapter's.
 * Unknown slugs fall back rather than failing; see `mailingList.signupChapter`.
 *
 * Both fields are optional INDIVIDUALLY and required TOGETHER: give us one of
 * an email or a phone. Enforced on the server (`mailingList.subscribe`); the
 * script below only says so earlier and more kindly.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { asset } from "../lib/asset";

const inputClass =
  "mt-1 w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-base text-ink outline-none focus:border-red-500";
---

<BaseLayout
  title="Stay in the loop"
  description="Get Public Worship's newsletter and event announcements — where we're worshipping next, and how to join us."
  canonical={new URL("/subscribe", Astro.site).toString()}
>
  <section class="py-12 sm:py-16">
    <Container size="default">
      <SectionHeading eyebrow="Newsletter" align="left" as="h1">
        Stay in the <span class="text-red-500">loop</span>
      </SectionHeading>
    </Container>
  </section>

  <section class="pb-20">
    <Container size="default" class="max-w-2xl">
      <p class="max-w-prose text-lg leading-relaxed text-ink/80">
        We send a newsletter when there's something worth saying — where we're
        worshipping next, what happened at the last one, and how to be part of
        it. No more than a couple of times a month.
      </p>

      <form class="mt-10 space-y-6" data-subscribe-form novalidate>
        {/* Honeypot: off-screen, never seen by a human, always filled by a
            naive bot. The server answers 200 to a filled one rather than an
            error — see `marketingApiRoutes.ts`. */}
        <div class="absolute left-[-9999px]" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <label class="block">
          <span class="text-sm font-semibold text-ink">Your name</span>
          <input
            type="text"
            name="name"
            required
            maxlength="120"
            autocomplete="name"
            class={inputClass}
          />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-ink">Email</span>
          <input
            type="email"
            name="email"
            maxlength="200"
            autocomplete="email"
            class={inputClass}
          />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-ink">
            Phone <span class="font-normal text-ink/50">(optional)</span>
          </span>
          <input
            type="tel"
            name="phone"
            maxlength="40"
            autocomplete="tel"
            class={inputClass}
          />
          {/* Consent language, not decoration: a phone number handed over on a
              newsletter form has not agreed to be texted unless the form says
              what it is agreeing to. Links to the same SMS terms every message
              points at. */}
          <span class="mt-2 block text-sm leading-relaxed text-ink/60">
            Give us a number and we may text you about upcoming gatherings.
            Message and data rates may apply; reply STOP any time to stop. See
            our <a
              href={asset("/sms-terms")}
              class="text-red-500 underline-offset-2 hover:underline"
              >SMS terms</a
            > and <a
              href={asset("/privacy")}
              class="text-red-500 underline-offset-2 hover:underline"
              >privacy policy</a
            >.
          </span>
        </label>

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            data-subscribe-submit
            class="inline-flex items-center rounded-full bg-red-500 px-7 py-3 text-base font-semibold text-white transition-opacity hover:opacity-90 disabled:opacity-50"
          >
            Sign me up
          </button>
          <p data-subscribe-status class="text-sm text-ink/70" role="status"></p>
        </div>
      </form>

      <div
        data-subscribe-done
        class="mt-10 hidden rounded-2xl border border-pink-soft/60 bg-pink-softer/40 p-6 sm:p-8"
      >
        <p class="font-display text-lg font-normal text-ink">You're on the list.</p>
        <p class="mt-2 max-w-prose text-base leading-relaxed text-ink/80">
          Thanks for saying yes. You'll hear from us before the next gathering —
          and every email has an unsubscribe link, no hard feelings.
        </p>
        <p class="mt-4">
          <a
            href={asset("/")}
            class="text-red-500 underline-offset-2 hover:underline"
            >Back to the homepage</a
          >
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import "../scripts/subscribe";
</script>

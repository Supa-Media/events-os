---
/**
 * /team — the org's front door for anyone who wants to join.
 *
 * Two jobs, in this order: show what's actually open, and tell people exactly
 * what happens after they apply. The second one is the part most such pages
 * skip, and it's the part that makes the promise on this page checkable — the
 * stages listed here are the same stages the Hiring desk moves a file through
 * (`@events-os/shared`'s `hiring.ts`), not marketing copy about them.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Button from "../../components/ui/Button.astro";
import RoleCard from "../../components/team/RoleCard.astro";
import HiringProcess from "../../components/team/HiringProcess.astro";
import { getRoles, openRoles, otherRoles } from "../../lib/roles";
import { RESPONSE_PROMISE_DAYS } from "@events-os/shared/src/hiring";
import { asset } from "../../lib/asset";

const roles = await getRoles();
const open = openRoles(roles);
const upcoming = otherRoles(roles);
---

<BaseLayout
  title="Join the team"
  description="Join the Public Worship team. Open seats, what each one actually owns, and exactly what happens after you apply."
  canonical={new URL("/team", Astro.site).toString()}
>
  <Container size="narrow" class="py-16 sm:py-24">
    <div class="flex flex-col items-start gap-3" data-animate="fade-up">
      <Eyebrow icon="sparkle">Join the team</Eyebrow>
      <h1
        class="font-display font-normal leading-[1.08] text-3xl sm:text-[42px] md:text-[52px]"
      >
        Build this with <span class="text-red-500">us</span>
      </h1>
      <p class="max-w-prose text-lg leading-relaxed text-ink/75">
        Public Worship is volunteer-led — nobody here draws a salary, including
        the people in these seats. What limits us isn't money or ideas; it's
        people and leadership capacity. So these are real seats: real
        ownership, real decisions, real weight.
      </p>
      <p class="max-w-prose text-base leading-relaxed text-ink/70">
        Every seat below says what you'd be accountable for, what you'd get to
        decide on your own, and what it is <em>not</em>. If we can't write that
        down, we're not ready to ask someone to do it.
      </p>
      <p class="max-w-prose text-base leading-relaxed text-ink/70">
        Want to help at a gathering rather than hold a seat? That's a different
        (and much shorter) door —
        <a href={asset("/serve")} class="text-red-500 underline-offset-2 hover:underline">volunteer with us</a>.
      </p>
    </div>

    {/* ── Open roles ─────────────────────────────────────────────── */}
    <section class="mt-14" data-animate="fade-up">
      <h2 class="font-display text-2xl font-normal text-ink">Open seats</h2>
      {
        open.length === 0 ? (
          <p class="mt-4 max-w-prose text-ink/70">
            Nothing is open at this moment — which usually means we're mid-way
            through filling something. Tell us who you are anyway; the pool
            below is where most of our roles get filled from.
          </p>
        ) : (
          <ul class="mt-6 space-y-5">
            {open.map((role) => (
              <li>
                <RoleCard role={role} />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {/* ── Everything else on the chart ───────────────────────────── */}
    {
      upcoming.length > 0 && (
        <section class="mt-14" data-animate="fade-up">
          <h2 class="font-display text-2xl font-normal text-ink">
            Not open yet
          </h2>
          <p class="mt-3 max-w-prose text-ink/70">
            Seats we know are coming. Nothing to apply for today — but if one of
            these is obviously you, say so and we'll come back to you when it
            opens.
          </p>
          <ul class="mt-6 space-y-5">
            {upcoming.map((role) => (
              <li>
                <RoleCard role={role} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* ── The general-interest door ──────────────────────────────── */}
    <section
      class="mt-14 rounded-2xl border border-pink-soft/60 bg-pink-softer/40 p-6 sm:p-8"
      data-animate="fade-up"
    >
      <h2 class="font-display text-xl font-normal text-ink">
        Don't see your seat?
      </h2>
      <p class="mt-3 max-w-prose text-ink/80">
        Most people on this team didn't arrive through a posting. Tell us what
        you'd want to own and how much time you actually have — that pool is
        the first place we look when something opens, and new chapters are
        coming, which means more seats than are listed here today.
      </p>
      <div class="mt-5">
        <Button href={asset("/team/apply")}>Tell us about you →</Button>
      </div>
    </section>

    {/* ── What happens after you apply ───────────────────────────── */}
    <section class="mt-16" data-animate="fade-up">
      <h2 class="font-display text-2xl font-normal text-ink">
        What happens after you apply
      </h2>
      <p class="mt-3 max-w-prose text-ink/75">
        The same for everyone — a friend of the team, a stranger who found this
        page, someone already serving with us. One door.
      </p>
      <HiringProcess />
      <p class="mt-6 max-w-prose text-sm text-ink/70">
        You'll hear from a person within {RESPONSE_PROMISE_DAYS} days either
        way. If the answer is no, you'll get a real one, not silence. If it's
        not now, we'll tell you when we're coming back to it.
      </p>
    </section>

    {/* ── The two things we ask everyone ─────────────────────────── */}
    <section class="mt-14 grid gap-5 sm:grid-cols-2" data-animate="fade-up">
      <div class="rounded-2xl border border-ink/10 bg-cream-soft p-6">
        <h3 class="font-display text-lg font-normal text-ink">
          Your hours, honestly
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-ink/75">
          Roughly 10 hours a week for a director seat, 5 for a team seat, plus
          recurring meetings. We ask early because it's a gate, not a
          formality: a brilliant person with no real time is still a no, and
          finding that out in month three costs you more than it costs us.
        </p>
      </div>
      <div class="rounded-2xl border border-ink/10 bg-cream-soft p-6">
        <h3 class="font-display text-lg font-normal text-ink">
          Where you're covered
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-ink/75">
          We ask everyone where they call home church, and how they're
          attending and giving there. Public Worship is not a church and won't
          be yours. Serving here is meant to be overflow from somewhere you're
          already planted — that's a specific concern, and we'd rather say it
          up front than discover it later.
        </p>
      </div>
    </section>

    <p class="mt-12 text-sm text-ink/60">
      Public Worship is a volunteer-run initiative of Global Echo Charitable
      Co., a 501(c)(3) nonprofit. Every role on this page is unpaid.
    </p>
  </Container>
</BaseLayout>

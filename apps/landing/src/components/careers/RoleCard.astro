---
/**
 * One role on the /careers index: enough to self-select out of, and nothing
 * more. The status chip, the hours, and who it reports to are on the card on
 * purpose — those are the three facts that decide whether someone should keep
 * reading, and burying them a page deeper wastes everybody's time.
 */
import {
  rolePath,
  statusChipClass,
  statusLabel,
  type Role,
} from "../../lib/roles";

export interface Props {
  role: Role;
}

const { role } = Astro.props;
const d = role.data;
---

<article
  class="rounded-2xl border border-ink/12 bg-cream-soft p-6 transition-all hover:border-red-500 hover:shadow-soft sm:p-7"
>
  <div class="flex flex-wrap items-center gap-3">
    <span
      class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide ${statusChipClass(d.status)}`}
    >
      {statusLabel(d.status)}
    </span>
    <span class="text-xs uppercase tracking-wide text-ink/55">{d.team}</span>
  </div>

  <h3 class="mt-3 font-display text-2xl font-normal leading-tight">
    <a href={rolePath(role)} class="hover:text-red-500">{d.title}</a>
  </h3>

  <p class="mt-3 max-w-prose text-base leading-relaxed text-ink/80">
    {d.summary}
  </p>

  <dl class="mt-5 grid gap-x-6 gap-y-2 text-sm text-ink/70 sm:grid-cols-2">
    <div class="flex gap-2">
      <dt class="font-semibold text-ink/60">Reports to</dt>
      <dd>{d.reportsTo}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-semibold text-ink/60">Time</dt>
      <dd>~{d.hoursPerWeek} hrs/week · {d.commitment}</dd>
    </div>
    <div class="flex gap-2 sm:col-span-2">
      <dt class="font-semibold text-ink/60">Where</dt>
      <dd>{d.location}</dd>
    </div>
  </dl>

  <a
    href={rolePath(role)}
    class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-red-500 hover:underline underline-offset-4"
  >
    Read the full role →
  </a>
</article>

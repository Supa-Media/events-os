---
/**
 * Important Links — the homepage's link grid.
 *
 * The cards are OS-managed now (`siteLinks` in Convex, edited on the Marketing
 * desk), fetched at runtime with the rest of the homepage's content by
 * `scripts/site-content.ts`. That script REPLACES the grid below once the live
 * content arrives, including choosing where the live event cards sit and which
 * ones show — the OS resolves that, because it is the only side that can see
 * the desk's pins, hides, and count.
 *
 * What is rendered here is the FALLBACK: `links.yaml`, which is what a visitor
 * sees if the backend is unreachable and what a crawler sees before JS runs.
 * See `lib/siteContent.ts` for why the homepage hydrates over real markup
 * instead of filling empty shells the way `/team` does.
 *
 * NEITHER AUTO ROW HAS A FALLBACK, and the blog posts row deliberately never
 * will. The events row's cards were always live data; a checked-in copy of
 * "the latest post" would be a stale claim about the org's writing baked into
 * a build, which is worse than no claim. So with the backend unreachable, or
 * with JS off, both rows contribute nothing and the grid below IS the page —
 * no empty heading, no orphaned section, no gap where cards would have been.
 */
import { getCollection } from "astro:content";
import { SITE_COPY_DEFS } from "@events-os/shared/src/marketing";
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import LinkCard from "../ui/LinkCard.astro";

// Ordering here mirrors the seed's: the `lead` card, then the events, then the
// rest. Live, that order is whatever the desk dragged it into.
const entries = await getCollection("links");
const lead = entries.filter((e) => e.data.slot === "lead");
const trail = entries.filter((e) => e.data.slot !== "lead");

// Reserve grid slots for the events so the trailing cards' entrance stagger
// stays continuous whether or not any are live. Matches the seeded row's
// `maxEvents`. The posts row gets no reserve: it is not in this file at all,
// and the stagger it would reserve for is a 60ms animation delay, not a slot.
const MAX_EVENTS = 2;
const delayFor = (i: number) => `--delay: ${i * 60}ms`;
---

<section id="links" class="py-20 sm:py-28 scroll-mt-16">
  <Container size="wide">
    <div
      class="flex flex-col items-center gap-3 text-center mb-12 sm:mb-14"
      data-animate="fade-up"
    >
      <Eyebrow icon="sparkle" copyKey="links.eyebrow">
        {SITE_COPY_DEFS["links.eyebrow"].defaultValue}
      </Eyebrow>
      {/* Source H2: 52px / 1.08 / Corben 400. */}
      <h2
        class="font-display font-normal leading-[1.08] text-3xl sm:text-[42px] md:text-[52px]"
      >
        <span data-copy-key="links.headingLead"
          >{SITE_COPY_DEFS["links.headingLead"].defaultValue}</span
        >{" "}<span class="text-red-500" data-copy-key="links.headingAccent"
          >{SITE_COPY_DEFS["links.headingAccent"].defaultValue}</span
        >
      </h2>
    </div>

    {/* `scripts/site-content.ts` replaces this grid's children wholesale once
        the live content lands. Until then (and forever, with JS off) these are
        the cards. */}
    <div
      id="pw-links-grid"
      class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        lead.map((entry, i) => (
          <div data-animate="fade-up" style={delayFor(i)}>
            <LinkCard
              title={entry.data.title}
              subtitle={entry.data.subtitle}
              url={entry.data.url}
              thumbnail={entry.data.thumbnail}
              bgImage={entry.data.bgImage}
              cta={entry.data.cta}
              copy={entry.data.copy}
              align={entry.data.align}
            />
          </div>
        ))
      }

      {
        trail.map((entry, i) => (
          <div
            data-animate="fade-up"
            style={delayFor(lead.length + MAX_EVENTS + i)}
          >
            <LinkCard
              title={entry.data.title}
              subtitle={entry.data.subtitle}
              url={entry.data.url}
              thumbnail={entry.data.thumbnail}
              bgImage={entry.data.bgImage}
              cta={entry.data.cta}
              copy={entry.data.copy}
              align={entry.data.align}
            />
          </div>
        ))
      }
    </div>
  </Container>
</section>

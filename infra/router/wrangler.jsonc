{
  // pw-router: the single Cloudflare Worker fronting publicworship.life.
  //
  // See ../../CLAUDE.md's URL-consolidation notes and src/route.ts's module
  // doc comment for the full routing table. In short:
  //   - publicworship.life (apex): /os/* -> Expo web app (prefix stripped),
  //     Convex prefixes (/event/, /e/, /t/, /give, /give/*, /p/, /reimburse/,
  //     /api/, /stripe/, /increase/) -> Convex HTTP actions (unchanged),
  //     everything else -> static assets (the Astro landing build).
  //   - www.publicworship.life -> 301 to https://publicworship.life<path>
  //   - events.publicworship.life -> 301 to https://publicworship.life/os<path>
  //   - rsvp.publicworship.life -> 301 to https://publicworship.life<path>
  //
  // DRAFT_PASSWORD (see "vars" below) — the shared password in front of
  // /blog/drafts/*, the unpublished blog posts. See src/draftGate.ts.
  //
  // Custom domains: this Worker is NOT attached to any route here. The four
  // hostnames above (publicworship.life, www., events., rsvp.) are attached
  // as Custom Domains / Routes in the Cloudflare dashboard by the account
  // owner, since that requires the zone to already be on Cloudflare DNS.
  // This file intentionally has no top-level "routes"/"route" key.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pw-router",
  "main": "src/index.ts",
  // Stable past date rather than "today": a future-dated (or clock-skewed)
  // runner can reject a compatibility_date that resolves to "in the future".
  "compatibility_date": "2026-07-01",

  "vars": {
    // The password in front of unpublished blog posts (/blog/drafts/*).
    //
    // THIS VALUE IS PUBLIC. It is committed to a public repository, so it is
    // readable by anyone who opens this file, and it will stay readable in
    // git history even after it is changed here. That is a deliberate,
    // eyes-open trade: this gate exists so a work-in-progress post isn't
    // sitting on a guessable URL for crawlers and casual visitors, not to
    // withstand anyone who thinks to check GitHub. Drafts of a marketing
    // blog are the only thing behind it, and nothing that would matter if
    // read early belongs in one.
    //
    // To make it genuinely private later:
    //   1. DELETE this whole "vars" block, then
    //   2. `npx wrangler secret put DRAFT_PASSWORD` from this directory.
    // Both steps, in that order — a plaintext var here and a secret of the
    // same name collide, and a deploy carrying the var would overwrite the
    // secret with this value. With the block gone and no secret set, the
    // drafts prefix fails CLOSED (503) rather than opening, so a
    // half-finished migration cannot publish a draft.
    "DRAFT_PASSWORD": "doxology"
  },

  "assets": {
    // Built by `pnpm --filter "./apps/landing" build` (Astro) before deploy —
    // see .github/workflows/deploy-landing.yml.
    "directory": "../../apps/landing/dist",
    "binding": "ASSETS",
    // apps/landing has no src/pages/404.astro at the time of writing, so
    // there's no dist/404.html for "404-page" mode to serve. Leaving
    // not_found_handling unset defaults to "none" (a plain 404 response for
    // unmatched asset requests) rather than misconfiguring against a file
    // that doesn't exist. If/when the landing site grows a 404 page, set
    // this to "404-page".
    // "not_found_handling": "404-page",

    // Worker-first is required because asset matching ignores hostname: with
    // the default assets-first behavior, rsvp.publicworship.life/ (or any
    // legacy-hostname path that happens to match a landing asset) would be
    // served the landing HTML directly instead of reaching the fetch handler
    // that 301s it. Running the Worker first keeps the hostname redirects
    // authoritative; src/index.ts falls through to env.ASSETS.fetch() for
    // landing paths.
    //
    // The negative patterns below exempt the pure static-asset directories
    // (apps/landing/public/: artifacts, decor, icons, images, links,
    // textures, videos; /_astro is Astro's hashed build output) so they hit
    // the asset fast path directly — cheaper and cacheable — instead of
    // round-tripping through the Worker. On a legacy hostname those paths
    // then serve the asset instead of a 301, which is harmless: only page
    // URLs (not raw asset paths) get shared or bookmarked.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/images/*",
      "!/videos/*",
      "!/icons/*",
      "!/decor/*",
      "!/links/*",
      "!/textures/*",
      "!/artifacts/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}
